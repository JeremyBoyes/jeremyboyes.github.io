---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, slugify, formatDate } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  const categoryNames = [
    ...new Set(posts.flatMap((post) => post.data.categories ?? [])),
  ];

  return categoryNames.map((categoryName) => ({
    params: { category: slugify(categoryName) },
    props: { categoryName },
  }));
}

const { categoryName } = Astro.props;

const posts = (await getPublishedPosts()).filter((post) =>
  (post.data.categories ?? []).some(
    (category) => slugify(category) === slugify(categoryName)
  )
);
---

<BaseLayout
  pageTitle={categoryName}
  metaTitle={`${categoryName} | Categories | Jeremy Boyes`}
  metaDescription={`Posts in the ${categoryName} category.`}
  activeNav="categories"
>
  <style>
    .category-page {
      padding: 1.3rem 2.3rem 1.25rem;
    }

    .category-shell {
      max-width: 860px;
      margin: 0 auto;
    }

    .post-list {
      display: grid;
      gap: 1rem;
    }

    .post-card {
      border: 1px solid var(--line);
      border-radius: 16px;
      background: color-mix(in srgb, var(--surface) 88%, var(--bg));
      padding: 1rem 1.05rem;
      transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
    }

    .post-card:hover {
      transform: translateY(-2px);
      border-color: var(--accent);
      background: color-mix(in srgb, var(--surface) 80%, var(--nav-active));
    }

    .post-date {
      margin: 0 0 0.45rem;
      color: var(--muted);
      font-size: 0.88rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .post-title {
      margin: 0 0 0.5rem;
      font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
      font-size: 1.1rem;
      line-height: 1.3;
    }

    .post-title a {
      color: var(--text);
      text-decoration: none;
    }

    .post-title a:hover {
      color: var(--accent);
    }

    .post-description {
      margin: 0 0 0.75rem;
      color: var(--muted);
      line-height: 1.65;
    }

    .post-categories {
      margin: 0;
      color: var(--muted);
      font-size: 0.92rem;
      line-height: 1.5;
    }

    @media (max-width: 900px) {
      .category-page {
        padding: 1.25rem 0 0;
      }
    }
  </style>

  <div class="category-page">
    <div class="category-shell">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
          <li><a href="/">Home</a></li>
          <li class="breadcrumb-separator" aria-hidden="true">›</li>
          <li><a href="/categories/">Categories</a></li>
          <li class="breadcrumb-separator" aria-hidden="true">›</li>
          <li aria-current="page">{categoryName}</li>
        </ol>
      </nav>

      <section class="page-card">
        <header class="page-header">
          <h1>{categoryName}</h1>
          <p>
            {posts.length} post{posts.length === 1 ? '' : 's'} in this category.
          </p>
        </header>

        <div class="post-list">
          {posts.map((post) => (
            <article class="post-card">
              <p class="post-date">{formatDate(post.data.lastUpdated ?? post.data.date)}</p>
              <h2 class="post-title">
                <a href={`/posts/${post.id}/`}>{post.data.title}</a>
              </h2>
              <p class="post-description">{post.data.description}</p>

              {(post.data.categories?.length ?? 0) > 0 && (
                <p class="post-categories">
                  Categories:{' '}
                  {post.data.categories?.map((category, index) => (
                    <>
                      <a href={`/categories/${slugify(category)}/`} class="category-link">
                        {category}
                      </a>
                      {index < (post.data.categories?.length ?? 0) - 1 && (
                        <span class="category-separator">, </span>
                      )}
                    </>
                  ))}
                </p>
              )}
            </article>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>