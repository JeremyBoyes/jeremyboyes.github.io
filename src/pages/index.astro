---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getPublishedPosts, formatDate, slugify } from '../lib/content';

const siteTitle = 'Jeremy Boyes';
const siteDescription = 'Application Packaging & Deployment | Intune | SCCM | PowerShell';

const allPosts = await getPublishedPosts();
const posts = allPosts.map(post => ({
  title: post.data.title,
  date: formatDate(post.data.date),
  categories: post.data.categories ?? [],
  excerpt: post.data.description,
  href: `/posts/${post.id}`,
  coverImage: post.data.coverImage,
  coverImageAlt: post.data.coverImageAlt ?? post.data.title,
}));
---

<BaseLayout
  pageTitle="Home"
  metaTitle={siteTitle}
  metaDescription={siteDescription}
  activeNav="home"
>
  <style>
    .home-page {
      padding: 1.3rem 2.3rem 1.25rem;
    }

    .home-shell {
      max-width: 860px;
      margin: 0 auto;
    }

    .post-list {
      display: grid;
      gap: 1rem;
    }

    .post-card {
      position: relative;
      display: flex;
      gap: 1.5rem;
      align-items: stretch;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 1.75rem;
      box-shadow: var(--shadow);
      transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .post-card-title-link {
      color: inherit;
      text-decoration: none;
      cursor: pointer;
    }

    /* Stretched-link pattern: the title holds the real link, this
       invisible overlay makes the whole card clickable. Elements that
       need their own independent link (e.g. category tags) sit above
       it with a higher z-index. */
    .post-card-title-link::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
    }

    .post-card-image {
      flex: 0 0 41.6667%;
      border-radius: 12px;
      overflow: hidden;
      background: var(--sidebar-bg);
    }

    .post-card-image img {
      box-sizing: border-box;
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center;
      padding: 0.25rem;
    }

    .post-card-body {
      flex: 1 1 58.3333%;
      min-width: 0;
    }

    .post-card:hover {
      background: var(--nav-active);
      border-color: var(--accent);
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.18);
    }

    .post-card-title-link:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
      border-radius: 4px;
    }

    .post-card-category {
      position: relative;
      z-index: 2;
      color: var(--muted);
      text-decoration: none;
    }

    .post-card-category:hover {
      color: var(--accent);
      text-decoration: underline;
    }

    .post-card h2 {
      margin: 0 0 0.75rem;
      font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
      font-size: 1.9rem;
      font-weight: 500;
      color: var(--text);
      line-height: 1.2;
    }

    .post-card p {
      margin: 0 0 1.15rem;
      color: var(--muted);
      font-size: 1.1rem;
      line-height: 1.7;
    }

    .post-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      color: var(--muted);
      font-size: 0.95rem;
    }

    .post-meta > span {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
    }

    @media (max-width: 900px) {
      .home-page {
        padding: 1.25rem 0 0;
      }

      .post-card {
        padding: 1.25rem;
      }
    }

    @media (max-width: 640px) {
      .post-card {
        flex-direction: column;
        gap: 1rem;
      }

      .post-card-image {
        flex: none;
        width: 100%;
      }

      .post-card-image img {
        aspect-ratio: 16 / 9;
      }
    }
  </style>

  <div class="home-page">
    <div class="home-shell">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
          <li aria-current="page">Home</li>
        </ol>
      </nav>

      <div class="post-list">
        {posts.map((post) => (
          <article class="post-card">
            {post.coverImage && (
              <div class="post-card-image">
                <Image
                  src={post.coverImage}
                  alt={post.coverImageAlt}
                  width={440}
                  height={Math.round(440 * (post.coverImage.height / post.coverImage.width))}
                />
              </div>
            )}
            <div class="post-card-body">
              <h2 data-pagefind-meta="title">
                <a class="post-card-title-link" href={post.href} data-pagefind-ignore>
                  {post.title}
                </a>
              </h2>
              <p data-pagefind-meta="description">{post.excerpt}</p>
              <div class="post-meta" data-pagefind-ignore>
                <span><i class="fa-regular fa-calendar"></i> {post.date}</span>
                {post.categories.length > 0 && (
                  <span>
                    <i class="fa-regular fa-folder-open"></i>
                    <span>{post.categories.map((category, index) => (
                      <>
                        <a href={`/categories/${slugify(category)}/`} class="post-card-category">{category}</a>{index < post.categories.length - 1 && ', '}
                      </>
                    ))}</span>
                  </span>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>