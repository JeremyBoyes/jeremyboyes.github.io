---
import BaseLayout from './BaseLayout.astro';
import ShareButtons from '../components/ShareButtons.astro';

interface Props {
  post: {
    title: string;
    description: string;
    date: Date;
    lastUpdated?: Date;
    author?: string;
    categories?: string[];
  };
}

const { post } = Astro.props;

const siteTitle = 'Jeremy Boyes';
const displayUpdated = post.lastUpdated ?? post.date;
const categoryList = post.categories ?? [];
const hasCategories = categoryList.length > 0;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const slugify = (value: string) =>
  value.toLowerCase().trim().replace(/\s+/g, '-');

const formatDate = (value: Date) =>
  value.toLocaleDateString('en-NZ', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
---

<BaseLayout
  pageTitle={post.title}
  metaTitle={`${post.title} | ${siteTitle}`}
  metaDescription={post.description}
  activeNav="home"
>
  <style>
    .content-post {
      padding: 1.3rem 2.3rem 1.25rem;
    }

    .post-toprow {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.5rem;
    }

    .post-shell {
      max-width: 860px;
      margin: 0 auto;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 18px;
      box-shadow: var(--shadow);
      padding: 1.6rem 1.6rem 2rem;
    }

    .breadcrumb-current {
      color: var(--muted);
    }

    .post-header {
      margin-bottom: 1.75rem;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid var(--line);
    }

    .post-meta-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
      margin-bottom: 1.4rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--line);
    }

    .post-meta-grid--two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .meta-block {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      min-width: 0;
    }

    .meta-block--right {
      text-align: right;
    }

    .meta-label {
      color: var(--muted);
      font-size: 0.8rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .meta-value {
      color: var(--text);
      font-size: 1.05rem;
      line-height: 1.35;
      overflow-wrap: anywhere;
    }

    .meta-value-categories {
      display: inline;
    }

    .post-header h1 {
      margin: 0 0 0.9rem;
      font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
      font-size: clamp(2rem, 3vw, 2.7rem);
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -0.02em;
      color: var(--text);
    }

    .post-description {
      margin: 0;
      color: var(--muted);
      font-size: 1.05rem;
      line-height: 1.7;
    }

    .post-body {
      color: var(--text);
      line-height: 1.85;
      font-size: 1rem;
    }

    .post-body :global(p) {
      margin: 0 0 1.1rem;
    }

    .post-body :global(h2),
    .post-body :global(h3),
    .post-body :global(h4) {
      color: var(--text);
      font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
      margin-top: 2rem;
      margin-bottom: 0.85rem;
      line-height: 1.2;
    }

    .post-body :global(h2) {
      font-size: 1.5rem;
      border-bottom: 1px solid var(--line);
      padding-bottom: 0.35rem;
    }

    .post-body :global(a) {
      color: var(--accent);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .post-body :global(ul),
    .post-body :global(ol) {
      padding-left: 1.4rem;
      margin: 0 0 1.1rem;
    }

    .post-body :global(li) {
      margin-bottom: 0.35rem;
    }

    .post-body :global(code) {
      background: var(--nav-active);
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 0.15rem 0.4rem;
      font-size: 0.92em;
    }

    .post-body :global(pre) {
      background: var(--sidebar-bg);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 1rem 1.1rem;
      overflow-x: auto;
      margin: 1.25rem 0;
    }

    .post-body :global(pre code) {
      background: transparent;
      border: 0;
      padding: 0;
    }

    @media (max-width: 900px) {
      .content-post {
        padding: 1rem 0 0;
      }

      .post-toprow {
        margin-bottom: 1rem;
      }

      .post-shell {
        max-width: 100%;
        padding: 1.15rem;
        border-radius: 16px;
      }

      .post-header {
        margin-bottom: 1.35rem;
        padding-bottom: 1rem;
      }

      .post-meta-grid {
        gap: 1rem;
        margin-bottom: 1.1rem;
        padding-bottom: 0.9rem;
      }

      .post-header h1 {
        margin-bottom: 0.75rem;
        font-size: clamp(1.8rem, 7vw, 2.3rem);
      }

      .post-description {
        font-size: 1rem;
        line-height: 1.6;
      }

      .post-body {
        font-size: 0.98rem;
        line-height: 1.75;
      }

      .post-body :global(h2) {
        font-size: 1.35rem;
      }

      .post-body :global(h3) {
        font-size: 1.15rem;
      }

      .post-body :global(pre) {
        padding: 0.9rem 1rem;
        border-radius: 12px;
      }
    }

    @media (max-width: 640px) {
      .post-meta-grid {
        grid-template-columns: 1fr;
        gap: 0.85rem;
      }

      .meta-block--right {
        text-align: left;
      }

      .meta-label {
        font-size: 0.76rem;
      }

      .meta-value {
        font-size: 1rem;
      }

      .post-shell {
        padding: 1rem;
        border-radius: 14px;
      }

      .post-header h1 {
        font-size: clamp(1.65rem, 8vw, 2.05rem);
      }

      .post-description {
        font-size: 0.98rem;
      }

      .post-body {
        font-size: 0.96rem;
      }

      .post-body :global(h2) {
        font-size: 1.25rem;
      }

      .post-body :global(h3) {
        font-size: 1.08rem;
      }

      .post-body :global(ul),
      .post-body :global(ol) {
        padding-left: 1.2rem;
      }
    }
  </style>

  <div class="content-post">
    <div class="post-toprow">
      <nav class="breadcrumb" aria-label="Breadcrumb" data-pagefind-ignore>
        <a href="/">Home</a>
        <span class="breadcrumb-separator">›</span>
        <span class="breadcrumb-current">{post.title}</span>
      </nav>
    </div>

    <article class="post-shell" data-pagefind-body>
      <header class="post-header">
        <div
          class:list={['post-meta-grid', !hasCategories && 'post-meta-grid--two']}
          data-pagefind-ignore
        >
          <div class="meta-block">
            <span class="meta-label">By</span>
            <span class="meta-value">{post.author ?? 'Jeremy Boyes'}</span>
          </div>

          <div class="meta-block">
            <span class="meta-label">Last Updated</span>
            <span class="meta-value">{formatDate(displayUpdated)}</span>
          </div>

          {hasCategories && (
            <div class="meta-block meta-block--right">
              <span class="meta-label">Categories</span>
              <div class="meta-value meta-value-categories">
                {categoryList.map((category, index) => (
                  <>
                    <a href={`/categories/${slugify(category)}/`} class="category-link">
                      {category}
                    </a>
                    {index < categoryList.length - 1 && (
                      <span class="category-separator">, </span>
                    )}
                  </>
                ))}
              </div>
            </div>
          )}
        </div>

        <h1 data-pagefind-meta="title">{post.title}</h1>
        <p class="post-description" data-pagefind-meta="description">
          {post.description}
        </p>
      </header>

      <div class="post-body">
        <slot />
      </div>

      <ShareButtons url={canonicalURL.href} title={post.title} />
    </article>
  </div>
</BaseLayout>