---
import BaseLayout from './BaseLayout.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { slugify, formatDate } from '../lib/content';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: {
    title: string;
    description: string;
    date: Date;
    lastUpdated?: Date;
    author?: string;
    categories?: string[];
  };
  headings?: Heading[];
}

const { post, headings = [] } = Astro.props;

const siteTitle = 'Jeremy Boyes';
const displayUpdated = post.lastUpdated ?? post.date;
const categoryList = post.categories ?? [];
const hasCategories = categoryList.length > 0;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const tocHeadings = headings.filter((heading) => heading.depth === 2);
const showToc = tocHeadings.length > 1;
---

<BaseLayout
  pageTitle={post.title}
  metaTitle={`${post.title} | ${siteTitle}`}
  metaDescription={post.description}
  activeNav="home"
>
  <style>
    .content-post {
      padding: 1.3rem 2.3rem 1.25rem;
    }

    .post-toprow {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.5rem;
    }

    .post-shell {
      max-width: 860px;
      margin: 0 auto;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 18px;
      box-shadow: var(--shadow);
      padding: 1.6rem 1.6rem 2rem;
    }

    .breadcrumb-current {
      color: var(--muted);
    }

    .post-header {
      margin-bottom: 1.75rem;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid var(--line);
    }

    .post-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }

    .post-tag {
      display: inline-block;
      font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--accent);
      background: color-mix(in srgb, var(--accent) 14%, var(--surface));
      border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--surface));
      padding: 0.25rem 0.65rem;
      border-radius: 6px;
      text-decoration: none;
      transition: background-color 0.15s ease, border-color 0.15s ease;
    }

    .post-tag:hover {
      background: color-mix(in srgb, var(--accent) 24%, var(--surface));
      border-color: var(--accent);
    }

    .post-meta-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
      margin-bottom: 1.4rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--line);
    }

    .meta-block {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      min-width: 0;
    }

    .meta-label {
      color: var(--muted);
      font-size: 0.8rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .meta-value {
      color: var(--text);
      font-size: 1.05rem;
      line-height: 1.35;
      overflow-wrap: anywhere;
    }

    .post-header h1 {
      margin: 0 0 0.9rem;
      font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
      font-size: clamp(2rem, 3vw, 2.7rem);
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -0.02em;
      color: var(--text);
    }

    .post-description {
      margin: 0;
      color: var(--muted);
      font-size: 1.05rem;
      line-height: 1.7;
    }

    .post-toc {
      background: var(--sidebar-bg);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 1.1rem 1.4rem;
      margin: 0 0 1.75rem;
    }

    .post-toc-label {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
      margin-bottom: 0.7rem;
    }

    .post-toc ol {
      margin: 0;
      padding-left: 1.2rem;
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
    }

    .post-toc li {
      font-size: 0.92rem;
      color: var(--text);
    }

    .post-toc a {
      color: var(--accent);
      text-decoration: none;
    }

    .post-toc a:hover {
      text-decoration: underline;
    }

    .post-body {
      color: var(--text);
      line-height: 1.85;
      font-size: 1rem;
      overflow-wrap: anywhere;
    }

    .post-body :global(p) {
      margin: 0 0 1.1rem;
    }

    .post-body :global(h2),
    .post-body :global(h3),
    .post-body :global(h4) {
      color: var(--text);
      font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
      margin-top: 2rem;
      margin-bottom: 0.85rem;
      line-height: 1.2;
    }

    .post-body :global(h2) {
      font-size: 1.5rem;
    }

    .post-body :global(h2:not(:first-of-type)) {
      margin-top: 2.75rem;
      padding-top: 2rem;
      border-top: 1px solid var(--line);
    }

    .post-body :global(h3) {
      font-size: 1.15rem;
      margin-top: 1.6rem;
      color: var(--accent);
    }

    .post-body :global(blockquote) {
      margin: 1.25rem 0;
      padding: 0.85rem 1.1rem;
      border-left: 3px solid var(--accent);
      background: var(--sidebar-bg);
      border-radius: 0 10px 10px 0;
      color: var(--text);
    }

    .post-body :global(blockquote p) {
      margin: 0;
    }

    .post-body :global(blockquote p + p) {
      margin-top: 0.6rem;
    }

    .post-body :global(.callout) {
      display: flex;
      gap: 0.85rem;
      align-items: flex-start;
      margin: 1.25rem 0;
      padding: 1rem 1.25rem;
      border-radius: 12px;
      background: var(--sidebar-bg);
      border: 1px solid var(--line);
    }

    .post-body :global(.callout-icon) {
      font-size: 1.1rem;
      line-height: 1;
      flex-shrink: 0;
      margin-top: 0.1rem;
    }

    .post-body :global(.callout-body) {
      min-width: 0;
    }

    .post-body :global(.callout-title) {
      font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
      font-size: 0.92rem;
      font-weight: 700;
      color: var(--accent);
      margin-bottom: 0.35rem;
    }

    .post-body :global(.callout-text) {
      font-size: 0.94rem;
      color: var(--text);
      line-height: 1.65;
    }

    .post-body :global(.callout-text p) {
      margin: 0 0 0.6rem;
    }

    .post-body :global(.callout-text p:last-child) {
      margin-bottom: 0;
    }

    .post-body :global(.callout-text ul),
    .post-body :global(.callout-text ol) {
      margin: 0.4rem 0 0;
      padding-left: 1.2rem;
    }

    .post-body :global(.callout-text li) {
      margin-bottom: 0.3rem;
    }

    .post-body :global(a) {
      color: var(--accent);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .post-body :global(ul),
    .post-body :global(ol) {
      padding-left: 1.4rem;
      margin: 0 0 1.1rem;
    }

    .post-body :global(li) {
      margin-bottom: 0.35rem;
    }

    .post-body :global(code) {
      background: var(--nav-active);
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 0.15rem 0.4rem;
      font-size: 0.92em;
      overflow-wrap: anywhere;
      word-break: break-word;
    }

    .post-body :global(pre) {
      position: relative;
      background: var(--sidebar-bg);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 1rem 3.6rem 1rem 1.1rem;
      overflow-x: auto;
      margin: 1.25rem 0;
    }

    .post-body :global(pre code) {
      background: transparent;
      border: 0;
      padding: 0;
    }

    .post-body :global(.code-copy-btn) {
      position: absolute;
      top: 0.6rem;
      right: 0.6rem;
      background: var(--nav-active);
      border: 1px solid var(--line);
      color: var(--text);
      font-size: 0.75rem;
      font-weight: 600;
      font-family: inherit;
      padding: 0.25rem 0.6rem;
      border-radius: 6px;
      cursor: pointer;
      opacity: 0.85;
      transition: opacity 0.15s, background 0.15s;
    }

    .post-body :global(.code-copy-btn:hover) {
      opacity: 1;
      background: var(--surface);
    }

    .post-body :global(table) {
      width: 100%;
      margin: 1.25rem 0;
      border-collapse: collapse;
      border: 1px solid var(--line);
      border-radius: 10px;
      overflow: hidden;
      font-size: 0.95rem;
      display: block;
      overflow-x: auto;
    }

    .post-body :global(th),
    .post-body :global(td) {
      padding: 0.55rem 0.85rem;
      border: 1px solid var(--line);
      text-align: left;
      vertical-align: top;
      white-space: nowrap;
    }

    .post-body :global(th) {
      background: var(--nav-active);
      color: var(--text);
      font-weight: 600;
      white-space: nowrap;
    }

    .post-body :global(td code),
    .post-body :global(th code) {
      overflow-wrap: normal;
      word-break: normal;
      white-space: nowrap;
    }

    .post-body :global(tbody tr:nth-child(even)) {
      background: var(--sidebar-bg);
    }

    @media (max-width: 900px) {
      .content-post {
        padding: 1rem 0 0;
      }

      .post-toprow {
        margin-bottom: 1rem;
      }

      .post-shell {
        max-width: 100%;
        padding: 1.15rem;
        border-radius: 16px;
      }

      .post-header {
        margin-bottom: 1.35rem;
        padding-bottom: 1rem;
      }

      .post-meta-grid {
        gap: 1rem;
        margin-bottom: 1.1rem;
        padding-bottom: 0.9rem;
      }

      .post-header h1 {
        margin-bottom: 0.75rem;
        font-size: clamp(1.8rem, 7vw, 2.3rem);
      }

      .post-description {
        font-size: 1rem;
        line-height: 1.6;
      }

      .post-body {
        font-size: 0.98rem;
        line-height: 1.75;
      }

      .post-body :global(h2) {
        font-size: 1.35rem;
      }

      .post-body :global(h3) {
        font-size: 1.15rem;
      }

      .post-toc {
        padding: 1rem 1.15rem;
      }

      .post-body :global(h2:not(:first-of-type)) {
        margin-top: 2.25rem;
        padding-top: 1.5rem;
      }

      .post-body :global(pre) {
        padding: 0.9rem 3.2rem 0.9rem 1rem;
        border-radius: 12px;
      }

      .post-body :global(table) {
        font-size: 0.88rem;
        border-radius: 12px;
      }

      .post-body :global(th),
      .post-body :global(td) {
        padding: 0.45rem 0.65rem;
      }
    }

    @media (max-width: 640px) {
      .post-meta-grid {
        grid-template-columns: 1fr;
        gap: 0.85rem;
      }

      .meta-label {
        font-size: 0.76rem;
      }

      .meta-value {
        font-size: 1rem;
      }

      .post-shell {
        padding: 1rem;
        border-radius: 14px;
      }

      .post-header h1 {
        font-size: clamp(1.65rem, 8vw, 2.05rem);
      }

      .post-description {
        font-size: 0.98rem;
      }

      .post-body {
        font-size: 0.96rem;
      }

      .post-body :global(h2) {
        font-size: 1.25rem;
      }

      .post-body :global(h3) {
        font-size: 1.08rem;
      }

      .post-body :global(ul),
      .post-body :global(ol) {
        padding-left: 1.2rem;
      }
    }
  </style>

  <div class="content-post">
    <div class="post-toprow">
      <nav class="breadcrumb" aria-label="Breadcrumb" data-pagefind-ignore>
        <a href="/">Home</a>
        <span class="breadcrumb-separator">›</span>
        <span class="breadcrumb-current">{post.title}</span>
      </nav>
    </div>

    <article class="post-shell" data-pagefind-body>
      <header class="post-header">
        {hasCategories && (
          <div class="post-tags" data-pagefind-ignore>
            {categoryList.map((category) => (
              <a href={`/categories/${slugify(category)}/`} class="post-tag">
                {category}
              </a>
            ))}
          </div>
        )}

        <div class="post-meta-grid" data-pagefind-ignore>
          <div class="meta-block">
            <span class="meta-label">By</span>
            <span class="meta-value">{post.author ?? 'Jeremy Boyes'}</span>
          </div>

          <div class="meta-block">
            <span class="meta-label">Last Updated</span>
            <span class="meta-value">{formatDate(displayUpdated)}</span>
          </div>
        </div>

        <h1 data-pagefind-meta="title">{post.title}</h1>
        <p class="post-description" data-pagefind-meta="description">
          {post.description}
        </p>
      </header>

      {showToc && (
        <nav class="post-toc" aria-label="Table of contents" data-pagefind-ignore>
          <div class="post-toc-label">Contents</div>
          <ol>
            {tocHeadings.map((heading) => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <div class="post-body">
        <slot />
      </div>

      <ShareButtons url={canonicalURL.href} title={post.title} />
    </article>
  </div>

  <script>
    function initCodeCopyButtons() {
      const blocks = document.querySelectorAll<HTMLPreElement>('.post-body pre');
      blocks.forEach((pre) => {
        if (pre.querySelector('.code-copy-btn')) return;

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'code-copy-btn';
        button.textContent = 'Copy';
        button.setAttribute('aria-label', 'Copy code to clipboard');

        button.addEventListener('click', async () => {
          const code = pre.querySelector('code');
          const text = code ? code.innerText : pre.innerText;
          try {
            await navigator.clipboard.writeText(text);
            button.textContent = 'Copied!';
          } catch {
            button.textContent = 'Error';
          }
          setTimeout(() => {
            button.textContent = 'Copy';
          }, 1800);
        });

        pre.appendChild(button);
      });
    }

    initCodeCopyButtons();
    document.addEventListener('astro:page-load', initCodeCopyButtons);
  </script>
</BaseLayout>